# Copia este archivo como `.env` y completa los valores.
# El archivo .env está en .gitignore: tus claves nunca se suben al repositorio.

# Token de @BotFather (obligatorio)
TELEGRAM_BOT_TOKEN=

# chat_id de administradores separados por coma (opcional).
# Habilita /revisar y muestra el número de suscriptores en /estado.
# Tu chat_id aparece al usar /estado en el bot.
ADMIN_CHAT_IDS=

# Búsqueda
SEARCH_QUERY=desarrollador
SEARCH_CITY=quito

# Portales activos: computrabajo, multitrabajos, indeed, remoteok
# (indeed suele bloquear con 403; remoteok trae empleos remotos globales)
SOURCES=computrabajo,multitrabajos

# Filtros por título (separados por coma, sin distinguir mayúsculas ni tildes).
# KEYWORDS vacío = no filtrar. Una oferta pasa si contiene al menos una palabra.
KEYWORDS=desarrollador,programador,developer,software,sistemas,frontend,backend,full stack,fullstack,devops,qa,data,python,java,javascript,.net,php
EXCLUDE_KEYWORDS=negocios,comercial,ventas

# Cada cuánto revisar los portales, en segundos (mínimo 300)
CHECK_INTERVAL_SECONDS=1800

# Ruta de la base de datos SQLite
DB_PATH=jobs.db

LOG_LEVEL=INFO
